@page "/Login"
@using System.ComponentModel.DataAnnotations
@inherits LoginPage
@layout HeadlessLayout

<PageTitle>Login</PageTitle>
<h1 class="mb-20"  Style="text-align: center;">Login</h1>
 
<MudGrid Justify="Justify.Center" >
    <MudItem xs="11" sm="7" >
        <MudPaper Class="pa-4 mud-width-full d-flex justify-center rounded-lg flex-column">
            <MudImage Src="Images/logo.png" Alt="Dima - Controle Financeiro" />
            <EditForm OnValidSubmit="TryOnValidSubmitAsync" Model="Model" Spacing="4">
                <DataAnnotationsValidator/>
                <MudTextField T="string"
                              Label="Email"
                              HelperText=""
                              Required="true"
                              Validation="@(new EmailAddressAttribute())"
                              InputType="InputType.Email"
                              For="@(()=>Model.Email)"
                              @bind-Value="Model.Email"/>
                
                <MudTextField
                    T="string" 
                    Label="Password"
                    Required="true"
                    Validation="@(new LengthAttribute(4, 100))"
                    HelperText="Choose a strong password"
                    InputType="InputType.Password"
                    For="@(()=>Model.Password)"
                    @bind-Value="Model.Password"/>

                <div Class="mt-10 d-flex flex-row justify-space-around">
                    @if (IsBusy)
                    {
                        <MudSkeleton Height="36px" Width="100px" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" />
                        <MudSkeleton Height="36px" Width="80px" SkeletonType="SkeletonType.Rectangle" Animation="Animation.Wave" />
                    }
                    else 
                    {                    
                        <MudButton ButtonType="ButtonType.Submit"  Variant="Variant.Filled" Color="Color.Primary">Entrar</MudButton>
                        <MudButton Href="/Register"  Variant="Variant.Outlined" Color="Color.Primary">Registrar</MudButton>
                    }
                </div>
            </EditForm>
            
        </MudPaper>
    </MudItem>
</MudGrid>
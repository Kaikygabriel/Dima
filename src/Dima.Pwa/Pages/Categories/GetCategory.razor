@page "/categories/details/{Id:guid}"
@inherits GetCategoryPage

<MudText Align="Align.Center" Typo="Typo.h2" Color="Color.Primary" Class="mt-10 mb-12"> Category </MudText>
<MudGrid Justify="Justify.Center">
@if (Category is null)
{
    <MudProgressCircular Color="Color.Default" Indeterminate="true" />
}
else if (!Category.IsSuccess )
{
    <MudAlert Severity="Severity.Error">@Category.Error!.Message</MudAlert>
}
else
{
    <MudItem xs="10" md="8">
        <MudPaper class="pa-4">
            <MudText Typo="Typo.h3" Align="Align.Center" Class="mb-4">@Category.Data!.Title</MudText>
            <MudDivider/>
            <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-6">@Category.Data!.Description</MudText>
        </MudPaper>
    </MudItem>
}
</MudGrid>    
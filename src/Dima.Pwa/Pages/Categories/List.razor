@page "/Categories"
@inherits ListPage

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h3">
            Categories
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/Categories/Create">
            New Category
        </MudButton>
    </MudStack>

    @if (Categories is null || !Categories.Any())
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Filled"
                  Icon="@Icons.Material.Filled.Info">
            No categories found.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="4">

            @foreach (var category in Categories)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">

                    <MudPaper Elevation="4"
                              Class="pa-5 d-flex flex-column justify-space-between"
                              Style="height:180px;border-radius:12px;">

                        <div>

                            <MudText Typo="Typo.h5"
                                     Color="Color.Primary">
                                @category.Title
                            </MudText>

                            <MudDivider Class="my-2"/>

                            <MudText Typo="Typo.body2">
                                @category.Description
                            </MudText>

                        </div>

                        <MudStack Row="true"
                                  Justify="Justify.FlexEnd"
                                  Class="mt-4">

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Primary"/>

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"/>

                        </MudStack>

                    </MudPaper>

                </MudItem>
            }

        </MudGrid>

        <MudStack AlignItems="AlignItems.Center" Class="mt-8">

            <MudPagination Count="@TotalPage"
                           Color="Color.Primary"
                           @bind-Selected="CurrentPage"
                           @onclick="@(() => GetCategories(CurrentPage))"/>

            <MudText Typo="Typo.caption" Class="mt-2">
                Page @CurrentPage of @TotalPage
            </MudText>

        </MudStack>
    }

</MudContainer>
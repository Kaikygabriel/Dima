@page "/Categories"
@inherits ListPage


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h3">
            Categories
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/Categories/Create">
            New Category
        </MudButton>
    </MudStack>

    @if (Categories is null || !Categories.Any())
    {
        <MudAlert Severity="Severity.Info"
                  Variant="Variant.Filled"
                  Icon="@Icons.Material.Filled.Info">
            No categories found.
        </MudAlert>
    }
    else
    {
        <MudDataGrid Items="@Categories"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     QuickFilter="SearchFunc"
                     Hideable="true">

            <ToolBarContent>
                <MudTextField @bind-Value="SearchTitle"
                              Placeholder="Filter Title"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              IconSize="Size.Medium"
                              Class="mt-0"/>
            </ToolBarContent>
            <Columns>

                <PropertyColumn Property="x => x.Id" Title="Id"/>
                <PropertyColumn Property="x => x.Title" Title="Título"/>

                <PropertyColumn Property="x => x.Description" Title="Descrição"/>

                <TemplateColumn Title="Ações">

                    <CellTemplate>

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       aria-label="Atualizar"
                                       Href="@($"/Categories/Edit/{context.Item.Id}")"/>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="Excluir"
                                       OnClick="@(() => OnDeleteClickedAsync(context.Item.Id, context.Item.Title))"
                        />

                    </CellTemplate>

                </TemplateColumn>

            </Columns>
        </MudDataGrid>

        <MudStack AlignItems="AlignItems.Center" Class="mt-8">

            <MudPagination Count="@TotalPage"
                           Color="Color.Primary"
                           @bind-Selected="CurrentPage"
                           @onclick="@(() => GetCategories(CurrentPage))"/>

            <MudText Typo="Typo.caption" Class="mt-2">
                Page @CurrentPage of @TotalPage
            </MudText>

        </MudStack>
    }

</MudContainer>

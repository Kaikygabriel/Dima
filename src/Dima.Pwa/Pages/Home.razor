@page "/"
@using Dima.Pwa.Components.Reports
@inherits HomePage

<MudGrid Justify="Justify.Center" Spacing="4" >
@if (FinanceSummary is null)
{
    <MudProgressCircular Indeterminate="true"></MudProgressCircular>
}
else
{
    <MudItem xs="11" md="10">
        <MudPaper>
            <MudText Typo="Typo.h4">Incomes</MudText>
            <MudText>@FinanceSummary.Income.ToString("C")</MudText>
            <MudDivider/>
            <MudText Typo="Typo.h4">Expenses</MudText>
            <MudText>@FinanceSummary.Expense.ToString("C")</MudText>
        </MudPaper>
        <MudPaper>
            <MudText Typo="Typo.h3">Incomes By Category</MudText>
            <IncomesByCategoryChart/>
        </MudPaper>
        <MudPaper>
            <MudText Typo="Typo.h3">Expenses By Category</MudText>
            <ExpensesByCategoryChart/>
        </MudPaper>
        
        <MudPaper>
            <MudText Typo="Typo.h3">Incomes and Expenses</MudText>
            <IncomesAndExpensesByCategoryChart/>
        </MudPaper>
    </MudItem>
}
</MudGrid>
@page "/checkout/{IdProduct:guid}"
@inherits CheckoutPage

@if (Product is null && Error is null)
{
    <MudProgressCircular Indeterminate="true"></MudProgressCircular>
}
else if (Error is not null)
{
    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center">
        <MudAlert Icon="@Icons.Material.Filled.Error">@Error.Title</MudAlert>
        <MudAlert Icon="@Icons.Material.Filled.Error">@Error.Message</MudAlert>
    </MudStack>
}
else
{
    <MudGrid Justify="Justify.Center" >
        <MudItem xs="11" md="7">
            <MudPaper Class="pa-2 mt-10">
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-5">Pedido</MudText>
                <MudText Typo="Typo.h3" Align="Align.Center" Class="mt-8">@Product!.Title</MudText>
                <MudText Typo="Typo.body2" Align="Align.Center" Class="mt-3 mb-10">@Product!.Description</MudText>
                
                @if (Voucher is not null)
                {
                    <MudText Typo="Typo.body2">Voucher @Voucher.Code Apply.</MudText>
                }

                <MudDivider></MudDivider>
                @if (Voucher is null)
                {
                    <MudText Typo="Typo.h4" Align="Align.Center" Class="mt-4">@Total.ToString("C")</MudText>      
                }
                else
                {
                    <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Row="true">
                        <MudText Typo="Typo.h4" Align="Align.Center" Class="mt-4"><s> @Product!.Price.ToString("C")</s></MudText>
                        <MudText  Typo="Typo.h4" Align="Align.Center" Class="mt-4">@Total.ToString("C")</MudText>
                    </MudStack>
                }
            </MudPaper>
            @if (Voucher is null)
            {
                <MudPaper Class="mt-8 pa-2">
                    <MudStack Row="true">
                        <MudTextField @bind-Value="VoucherCode"
                                      Placeholder="Inserir Cupom de Desconto"></MudTextField>
                        <MudButton
                            Variant="Variant.Filled"
                            Color="Color.Primary"
                            Size="Size.Large"
                            OnClick="InsertVoucher">
                            Inserir
                        </MudButton>     
                    </MudStack>
                </MudPaper>    
            }
            @if (!IsBusy)
            {
                <MudButton 
                    Variant="Variant.Filled"
                    Color="Color.Primary"
                    Size="Size.Large"
                    Class="mt-5"
                    FullWidth="true "
                    OnClick="OnValidSubmit"
                    >
                    Finalizar Pedido
                </MudButton>
            }
            else
            {
                <MudSkeleton    Class="mt-5"  SkeletonType="SkeletonType.Rectangle" Animation="Animation.Pulse"></MudSkeleton>
            }
        </MudItem>
    </MudGrid>
}

@page "/launch/history"
@inherits ListPage

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h3">
            Transactions
        </MudText>

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   Href="/transactions/create">
            New Transactions
        </MudButton>
    </MudStack>
    
    <MudStack Class="mb-6">
        <MudStack Row="true" Justify="Justify.SpaceAround">
            <div style="width: 90%">
                <label
                    for="start-date">Start Date</label>
                <MudDatePicker
                    id="start-date"
                    Class="mt-3 mb-4"
                    @bind-Date="Start"/>
            </div>
            <div style="width: 90%">
                <label for="end-date">End Date</label>
                <MudDatePicker
                    id="end-date"
                    Class="mt-3 mb-4"
                    @bind-Date="End"/>
            </div>
                
        </MudStack>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="GetTransactions">Filtrar </MudButton>
    </MudStack>

    @if (Transactions is null || !Transactions.Any())
    {
        <MudAlert Severity="Severity.Error"
                  Variant="Variant.Filled"
                  Icon="@Icons.Material.Filled.Error">
            No Transactions found.
        </MudAlert>
    }
    else
    {
        <MudDataGrid Items="@Transactions"
                     Hover="true"
                     Dense="true"
                     Bordered="true"
                     Striped="true"
                     QuickFilter="SearchFunc"
                     Hideable="true">

            <ToolBarContent>
                <MudTextField @bind-Value="TermSearch"
                              Placeholder="Filter Title"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              IconSize="Size.Medium"
                              Class="mt-0"/>
            </ToolBarContent>
            <Columns>

                <TemplateColumn Title="Id">
                    <CellTemplate >
                        <MudLink Href="@($"/Transactions/details/{context.Item.Id}")"
                                 Typo="Typo.body2">
                            @context.Item.Id
                        </MudLink>
                    </CellTemplate>
                </TemplateColumn>
                
                <PropertyColumn Property="x => x.Title"  Title="Título"/>

                <PropertyColumn Property="x => x.EType" Title="Tipo"/>
                
                <PropertyColumn Format="C" Property="x => x.Amount" Title="Valor"/>
                
                <PropertyColumn Property="x => x.PaidOrReceivedAt" Title="Data"/>
                
                <PropertyColumn Property="x => x.Category.Title" Title="Categoria"/>
                
                <PropertyColumn Property="x => x.CreateAt" Title="Criação"/>

                <TemplateColumn Title="Ações">

                    <CellTemplate>

                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       aria-label="Atualizar"
                                       Href="@($"/categories/edit/{context.Item.Id}")"/>

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="Excluir"
                                       OnClick="@(() => GetDeleteAsync(context.Item.Id,context.Item.Title))"
                        />

                    </CellTemplate>

                </TemplateColumn>

            </Columns>
        </MudDataGrid>
    }

</MudContainer>

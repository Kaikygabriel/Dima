@using Dima.Pwa.Security
@inherits LayoutComponentBase
@inject ICookieAuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav

<MudThemeProvider @ref="_mudThemeProvider" Theme="Configuration.Theme" @bind-IsDarkMode="_isDarkMode"/>

<MudPopoverProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudMainContent>
        <MudContainer>
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;
    
    protected override async Task OnInitializedAsync()
    {
        var userAuth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (userAuth.User.Identity is {IsAuthenticated : true})
            Nav.NavigateTo("/");
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }
}
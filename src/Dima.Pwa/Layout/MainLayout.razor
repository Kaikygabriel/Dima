@using System.Security.Claims
@using Dima.Pwa.Components
@using Dima.Pwa.Components.Identity
@using Dima.Pwa.Configurations
@inherits LayoutComponentBase

<MudThemeProvider @ref="_providerTheme" @bind-IsDarkMode="_isDarkMode"  Theme="Configuration.Theme" />
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<AuthorizeView>
    <Authorized>
        <MudLayout>
            <MudAppBar Elevation="1">
                <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
                <MudSpacer />
                <p>@context.User.Claims.FirstOrDefault(x=>x.Type == ClaimTypes.Email)?.Value</p>
            </MudAppBar>
    
            <MudDrawer @bind-Open="@_open" Elevation="1">
                <NavMenu />
            </MudDrawer>
    
            <MudMainContent>
                @Body
            </MudMainContent>
        </MudLayout>
    </Authorized>
    <NotAuthorized>
        
        <h1>Voce não esta autenticado</h1>
        <LoginRedirect/>
        
    </NotAuthorized>
</AuthorizeView>



@code{
    private bool _open;
    private MudThemeProvider _providerTheme = null!;
    private bool _isDarkMode;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _isDarkMode = await _providerTheme.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}
@inherits IncomesAndExpensesByCategoryChartComponent
@using MudBlazor.Charts;

<MudToolBar>
    <MudMenu Modal="false" Variant="Variant.Outlined" EndIcon="@MenuIcons[ChartType]" IconColor="Color.Primary"
             Label="Chart Type">
        <MudMenuItem Icon="@MenuIcons[ChartType.Bar]" Label="Bar" OnClick="() => ChartType = ChartType.Bar"
                     Disabled="@(ChartType == ChartType.Bar)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.StackedBar]" Label="Stacked Bar"
                     OnClick="() => ChartType = ChartType.StackedBar" Disabled="@(ChartType == ChartType.StackedBar)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.Line]" Label="Line" OnClick="() => ChartType = ChartType.Line"
                     Disabled="@(ChartType == ChartType.Line)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.Pie]" Label="Pie" OnClick="() => ChartType = ChartType.Pie"
                     Disabled="@(ChartType == ChartType.Pie)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.Donut]" Label="Donut" OnClick="() => ChartType = ChartType.Donut"
                     Disabled="@(ChartType == ChartType.Donut)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.Rose]" Label="Rose" OnClick="() => ChartType = ChartType.Rose"
                     Disabled="@(ChartType == ChartType.Rose)"/>
        <MudMenuItem Icon="@MenuIcons[ChartType.Radar]" Label="Radar" OnClick="() => ChartType = ChartType.Radar"
                     Disabled="@(ChartType == ChartType.Radar)"/>
    </MudMenu>
</MudToolBar>

<MudChart ChartType="ChartType"
          ChartSeries="Series"
          ChartLabels="@AxisLabels"
          Width="100%" Height="400px" CanHideSeries MatchBoundsToSize/>
